<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GlobalCity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy_deep</item>
        <item name="colorAccent">@color/green</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.GlobalCity.Splash">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@color/navy_deep</item>
    </style>

</resources>
